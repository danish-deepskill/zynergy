# Postgres connection (local dev: docker container zynergy-pg, port 5433)
DATABASE_URI=postgres://postgres:zynergy-dev@127.0.0.1:5433/zynergy

# Payload auth secret — generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Vercel Blob storage for uploads. Leave empty locally (files go to ./media
# and ./lead-files on disk); set on Vercel to switch media storage to Blob.
BLOB_READ_WRITE_TOKEN=
